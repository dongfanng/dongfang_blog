---
import BaseLayout from './BaseLayout.astro';
import { formatDate, formatDateTime } from '@/utils/date';
import { siteConfig } from '@/config/site';
import Icon from '@/components/ui/Icon.astro';
import { Image } from 'astro:assets';
import TableOfContents from '@/components/article/TableOfContents.astro';
import Comments from '@/components/article/Comments.astro';
import SeriesNav from '@/components/article/SeriesNav.astro';
import type { BlogPost, SeriesNav as SeriesNavData } from '@/utils/posts';
import { getReadingTime, getWordCount, getSeriesHref } from '@/utils/posts';
import 'katex/dist/katex.min.css';

interface Props {
  post: BlogPost;
  headings?: { depth: number; text: string; slug: string }[];
  related?: BlogPost[];
  seriesNav?: SeriesNavData | null;
  /** 最后更新时间：frontmatter.updatedDate 或 git 提交时间 */
  updatedDate?: Date | null;
}

const { post, headings = [], related, seriesNav = null, updatedDate = null } = Astro.props;
const { title, description, pubDate, category, tags, image } = post.data;
const readingTime = getReadingTime(post.body);
const wordCount = getWordCount(post.body);
---

<BaseLayout title={title} description={description} image={typeof image === 'string' ? image : image?.src} pubDate={pubDate} updatedDate={updatedDate ?? undefined} category={category} tags={tags}>
  <div class="container-prose py-8">
    <article>
    <header class="mb-8">
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <a href={`/blog/categories/${category}`} class="inline-flex items-center px-2.5 py-0.5 rounded-full text-sm font-medium bg-gray-100 text-gray-700 dark:bg-gray-800 dark:text-gray-300">
          {category}
        </a>
        {seriesNav && (
          <a
            href={getSeriesHref(seriesNav.series)}
            class="inline-flex items-center px-2.5 py-0.5 rounded-full text-sm font-medium bg-primary-50 text-primary-700 dark:bg-primary-950/50 dark:text-primary-300 hover:bg-primary-100 dark:hover:bg-primary-900/50 transition-colors"
          >
            系列 · {seriesNav.series} · {seriesNav.index + 1}/{seriesNav.total}
          </a>
        )}
        <time class="text-sm text-gray-500 dark:text-gray-400">
          发布于 {formatDate(pubDate)}
        </time>
        <span class="text-sm text-gray-500 dark:text-gray-400">·</span>
        <span class="text-sm text-gray-500 dark:text-gray-400">
          {wordCount} 字
        </span>
        <span class="text-sm text-gray-500 dark:text-gray-400">·</span>
        <span class="text-sm text-gray-500 dark:text-gray-400">
          约 {readingTime} 分钟阅读
        </span>
      </div>
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">
        {title}
      </h1>
      <p class="text-lg text-gray-600 dark:text-gray-400 mb-4">
        {description}
      </p>
      <div class="flex flex-wrap gap-2">
        {tags.map((tag: string) => (
          <a
            href={`/blog/tags/${tag}`}
            class="inline-flex items-center px-2.5 py-0.5 rounded-full text-sm font-medium bg-gray-100 text-gray-600 dark:bg-gray-800 dark:text-gray-400 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors"
          >
            #{tag}
          </a>
        ))}
      </div>
      {seriesNav && (
        <details class="xl:hidden mt-4 rounded-lg border border-gray-200 dark:border-gray-800">
          <summary class="cursor-pointer px-3 py-2 text-sm font-medium text-gray-700 dark:text-gray-300">
            本系列目录
          </summary>
          <div class="px-3 pb-3">
            <SeriesNav seriesNav={seriesNav} variant="inline" />
          </div>
        </details>
      )}
    </header>

    {image && (
      typeof image === 'string' ? (
        <img
          src={image}
          alt={title}
          class="w-full aspect-video object-cover rounded-2xl mb-8"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      ) : (
        <Image
          src={image}
          alt={title}
          class="w-full aspect-video object-cover rounded-2xl mb-8"
          widths={[480, 800, 1200]}
          sizes="(max-width: 768px) 100vw, 768px"
          loading="eager"
          fetchpriority="high"
        />
      )
    )}

    <div class="prose max-w-none">
      <slot />
    </div>

    <div class="mt-6 flex items-center justify-end sm:justify-between text-sm text-gray-500 dark:text-gray-400">
      <a
        href={`${siteConfig.social.github}/edit/main/src/content/blog/${post.slug}.md`}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex hover:text-primary-500 dark:hover:text-primary-400 transition-colors items-center gap-1.5"
      >
        <Icon name="square-pen" class="w-4 h-4" />
        在 GitHub 上编辑此页
      </a>
      <span class="inline-flex items-center gap-1.5">
        <Icon name="clock" class="w-4 h-4" />
        最后更新于: {formatDateTime(updatedDate || pubDate)}
      </span>
    </div>

    {related && related.length > 0 && (
      <section class="mt-8 pt-8 border-t border-gray-200 dark:border-gray-800">
        <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4">相关文章</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {related.map((p) => (
            <a
              href={`/blog/${p.slug}`}
              class="group p-4 rounded-xl border border-gray-200 dark:border-gray-800 hover:border-gray-300 dark:hover:border-gray-700 transition-colors"
            >
              <div class="font-medium text-gray-900 dark:text-white group-hover:text-primary-500 dark:group-hover:text-primary-400 transition-colors line-clamp-2">
                {p.data.title}
              </div>
              <div class="text-sm text-gray-500 dark:text-gray-400 mt-1">
                {formatDate(p.data.pubDate)}
              </div>
            </a>
          ))}
        </div>
      </section>
    )}
    </article>
    <Comments />
  </div>

  {seriesNav && (
    <aside class="hidden xl:block fixed top-24 z-30 w-48" style="left: calc(50% - 42rem);">
      <div class="max-h-[calc(100vh-6rem)] overflow-y-auto">
        <SeriesNav seriesNav={seriesNav} variant="aside" />
      </div>
    </aside>
  )}

  {headings.length > 0 && (
    <aside class="hidden xl:block fixed top-24 z-30 w-48" style="left: calc(50% + 30rem);">
      <div class="max-h-[calc(100vh-6rem)] overflow-y-auto">
        <TableOfContents headings={headings} />
      </div>
    </aside>
  )}

  <button
    type="button"
    id="back-to-top"
    hidden
    class="fixed bottom-8 right-8 p-3 rounded-full shadow-lg hover:opacity-80 transition-all duration-200 text-white bg-primary-500 dark:bg-primary-400"
    aria-label="回到顶部"
  >
    <Icon name="arrow-up" class="w-5 h-5" />
  </button>

  <script>
    import '@/scripts/post-enhancements';
  </script>

  <!-- 静态引入（脚本内部会检测是否存在 mermaid 块，无则直接跳过，mermaid 库按需动态加载） -->
  <script>
    import '@/scripts/mermaid';
  </script>
</BaseLayout>

<style is:global>
.lightbox-overlay {
  position: fixed;
  inset: 0;
  z-index: 9999;
  background: rgba(0, 0, 0, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: zoom-out;
  backdrop-filter: blur(4px);
}
.lightbox-overlay[hidden] {
  display: none;
}
.lightbox-image {
  max-width: 90vw;
  max-height: 90vh;
  object-fit: contain;
  border-radius: 0.5rem;
  cursor: default;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
}
.lightbox-close {
  position: absolute;
  top: 1rem;
  right: 1rem;
  padding: 0.5rem;
  border-radius: 0.5rem;
  background: rgba(255, 255, 255, 0.1);
  color: white;
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
}
.lightbox-close:hover {
  background: rgba(255, 255, 255, 0.2);
}
/* Mermaid 图表水平居中；svg 超宽时容器可横向滚动 */
.mermaid-container {
  position: relative;
  text-align: center;
}
.mermaid-container svg {
  display: inline-block;
  max-width: 100%;
  height: auto;
}
/* 放大按钮：hover 显示 */
.mermaid-zoom-btn {
  position: absolute;
  top: 0.25rem;
  right: 0.25rem;
  z-index: 2;
  width: 1.75rem;
  height: 1.75rem;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgb(100 116 139);
  background-color: rgb(255 255 255 / 0.8);
  border: 1px solid rgb(229 231 235);
  border-radius: 0.375rem;
  opacity: 0;
  cursor: pointer;
  transition: opacity 0.2s, background-color 0.2s;
}
.mermaid-zoom-btn svg {
  width: 1rem;
  height: 1rem;
}
.mermaid-container:hover .mermaid-zoom-btn,
.mermaid-zoom-btn:focus-visible {
  opacity: 1;
}
.dark .mermaid-zoom-btn {
  color: rgb(148 163 184);
  background-color: rgb(31 41 55 / 0.8);
  border-color: rgb(55 65 81);
}
/* 全屏查看器 */
.mermaid-lightbox {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 2rem;
  background: rgb(0 0 0 / 0.9);
  cursor: zoom-out;
}
.mermaid-lightbox svg {
  width: auto !important;
  height: auto !important;
  max-width: min(95vw, 100%) !important;
  max-height: 90vh !important;
}
.mermaid-lightbox-close {
  position: absolute;
  top: 1rem;
  right: 1rem;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0.5rem;
  border-radius: 0.5rem;
  background: rgb(255 255 255 / 0.1);
  color: #fff;
  border: none;
  cursor: pointer;
}
.mermaid-lightbox-close:hover {
  background: rgb(255 255 255 / 0.2);
}
</style>
