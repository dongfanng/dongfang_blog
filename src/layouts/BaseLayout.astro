---
import BaseHead from '@/components/layout/BaseHead.astro';
import SiteHeader from '@/components/layout/SiteHeader.astro';
import Footer from '@/components/layout/Footer.astro';
import '@/styles/global.css';
import type { SEOProps } from '@/utils/seo';
import { getPublishedPosts, getSeriesList } from '@/utils/posts';

interface Props extends SEOProps {}

const seriesList = getSeriesList(await getPublishedPosts());
---

<!DOCTYPE html>
<html lang="zh-CN">
  <BaseHead {...Astro.props} />
  <body class="min-h-screen flex flex-col pt-16">
    <SiteHeader {seriesList} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

{import.meta.env.PROD && (
<script is:inline>
  window.__loadPagefind = async function () {
    if (window.pagefind) return window.pagefind;
    const pagefind = await import('/pagefind/pagefind.js');
    await pagefind.options({ excerptLength: 20 });
    window.pagefind = pagefind;
    return pagefind;
  };
</script>
)}
