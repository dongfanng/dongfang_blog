---
import { siteConfig } from '@/config/site';
import type { SeriesListItem } from '@/utils/series';
import { getSeriesHref } from '@/utils/series';
import VueSearch from '@/components/search/VueSearch.vue';
import Icon from '@/components/ui/Icon.astro';

interface Props {
  seriesList: SeriesListItem[];
}

const { seriesList } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const inSection = (href: string) => pathname === href || (href !== '/' && pathname.startsWith(`${href}/`));
const activeHref = pathname === '/' || pathname.startsWith('/page/')
  ? '/'
  : siteConfig.nav.find((item) => inSection(item.href))?.href;

const desktopLinkClass =
  'inline-flex h-11 items-center transition-colors hover:text-primary-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 dark:hover:text-primary-400 dark:focus-visible:ring-primary-400 dark:focus-visible:ring-offset-gray-900';

const mobileLinkClass =
  'block rounded-lg px-3 py-2.5 transition-colors hover:bg-gray-100 hover:text-primary-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 dark:hover:bg-gray-800 dark:hover:text-primary-400 dark:focus-visible:ring-primary-400';

const desktopActiveClass = 'border-b-2 border-primary-500 font-semibold text-primary-600 dark:text-primary-400';
const desktopIdleClass = 'text-gray-600 dark:text-gray-300';
const mobileActiveClass = 'bg-primary-50 font-semibold text-primary-700 dark:bg-primary-950/40 dark:text-primary-300';
const mobileIdleClass = 'text-gray-600 dark:text-gray-300';

const seriesLinkClass =
  'flex items-center justify-between gap-3 rounded-lg px-3 py-2 text-sm transition-colors hover:bg-gray-100 hover:text-primary-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 dark:hover:bg-gray-800 dark:hover:text-primary-400 dark:focus-visible:ring-primary-400';
const seriesActiveClass = 'bg-primary-50 font-medium text-primary-700 dark:bg-primary-950/40 dark:text-primary-300';
const seriesIdleClass = 'text-gray-600 dark:text-gray-300';
---

<header class="fixed top-0 left-0 right-0 z-50 bg-white/80 dark:bg-gray-900/80 backdrop-blur-md border-b border-gray-200 dark:border-gray-800">
  <div class="container-prose">
    <div class="flex items-center justify-between h-16">
      <a href="/" class="text-xl font-bold text-gray-900 dark:text-white hover:text-primary-600 dark:hover:text-primary-400 transition-colors">
        {siteConfig.name}
      </a>

      <nav class="flex h-full items-center gap-3">
        <div class="hidden sm:flex h-full items-center gap-5 mr-2">
          {siteConfig.nav.map((item) =>
            'dropdown' in item ? (
              <div class="group relative flex h-full items-center">
                <a
                  href={item.href}
                  class:list={[desktopLinkClass, activeHref === item.href ? desktopActiveClass : desktopIdleClass]}
                  aria-current={pathname === item.href ? 'page' : undefined}
                >
                  {item.title}
                </a>
                {seriesList.length > 0 && (
                  <div class="invisible absolute left-0 top-full z-50 w-56 pt-2 opacity-0 transition-[opacity,visibility] duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
                    <div class="-translate-y-1 rounded-xl border border-gray-200 bg-white/95 p-2 shadow-xl backdrop-blur-md transition-transform duration-150 group-hover:translate-y-0 group-focus-within:translate-y-0 motion-reduce:transition-none dark:border-gray-700 dark:bg-gray-900/95">
                      {seriesList.map((series) => (
                        <a
                          href={getSeriesHref(series.name)}
                          class:list={[seriesLinkClass, pathname === getSeriesHref(series.name) ? seriesActiveClass : seriesIdleClass]}
                          aria-current={pathname === getSeriesHref(series.name) ? 'page' : undefined}
                        >
                          <span class="truncate">{series.name}</span>
                          <span class="shrink-0 text-xs text-gray-400 dark:text-gray-500">{series.count} 篇</span>
                        </a>
                      ))}
                    </div>
                  </div>
                )}
              </div>
            ) : (
              <a
                href={item.href}
                class:list={[desktopLinkClass, activeHref === item.href ? desktopActiveClass : desktopIdleClass]}
                aria-current={pathname === item.href ? 'page' : undefined}
              >
                {item.title}
              </a>
            )
          )}
        </div>

        <VueSearch client:idle />

        <button
          type="button"
          id="theme-toggle"
          class="inline-flex h-11 w-11 items-center justify-center rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
          aria-label="切换主题"
        >
          <Icon name="sun" class="text-[1.25rem] w-[1.25rem] h-[1.25rem] text-yellow-500 hidden dark:block" />
          <Icon name="moon" class="text-[1.25rem] w-[1.25rem] h-[1.25rem] text-gray-600 dark:text-gray-400 block dark:hidden" />
        </button>

        <button
          type="button"
          id="mobile-menu-toggle"
          class="sm:hidden inline-flex h-11 w-11 items-center justify-center rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
          aria-label="菜单"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <Icon id="icon-menu" name="menu" class="text-[1.25rem] w-[1.25rem] h-[1.25rem] text-gray-600 dark:text-gray-300" />
          <Icon id="icon-close" name="x" class="hidden text-[1.25rem] w-[1.25rem] h-[1.25rem] text-gray-600 dark:text-gray-300" />
        </button>
      </nav>
    </div>
  </div>

  <div
    id="mobile-menu"
    data-open="false"
    aria-hidden="true"
    inert
    class="collapse-panel sm:hidden border-t border-transparent transition-[grid-template-rows,opacity,visibility,border-color] duration-200 ease-out motion-reduce:transition-none data-[open=true]:border-gray-900/10 dark:data-[open=true]:border-white/10"
  >
    <div>
      <div class="container-prose py-2">
        {siteConfig.nav.map((item) => (
          <a
            href={item.href}
            class:list={[mobileLinkClass, activeHref === item.href ? mobileActiveClass : mobileIdleClass]}
            aria-current={pathname === item.href ? 'page' : undefined}
            data-close-mobile
          >
            {item.title}
          </a>
        ))}
      </div>
    </div>
  </div>
</header>

<script>
  let headerAbortController: AbortController | null = null;

  function bindHeader() {
    const themeToggle = document.getElementById('theme-toggle');
    if (!themeToggle || themeToggle.dataset.bound === '1') return;
    themeToggle.dataset.bound = '1';

    headerAbortController?.abort();
    headerAbortController = new AbortController();
    const { signal } = headerAbortController;

    const menuToggle = document.getElementById('mobile-menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const iconMenu = document.getElementById('icon-menu');
    const iconClose = document.getElementById('icon-close');

    let openScrollY = 0;
    const isMobileOpen = () => menuToggle?.getAttribute('aria-expanded') === 'true';

    themeToggle.addEventListener('click', () => {
      const next = document.documentElement.classList.contains('dark') ? 'light' : 'dark';
      localStorage.setItem('theme', next);
      document.documentElement.classList.toggle('dark', next === 'dark');
    });

    const setMobileOpen = (open: boolean) => {
      if (!mobileMenu) return;
      mobileMenu.dataset.open = String(open);
      mobileMenu.setAttribute('aria-hidden', String(!open));
      mobileMenu.inert = !open;
      menuToggle?.setAttribute('aria-expanded', String(open));
      iconMenu?.classList.toggle('hidden', open);
      iconClose?.classList.toggle('hidden', !open);
      if (open) {
        openScrollY = window.scrollY;
      }
    };

    menuToggle?.addEventListener('click', () => {
      setMobileOpen(!isMobileOpen());
    });

    document.querySelectorAll('[data-close-mobile]').forEach((el) => {
      el.addEventListener('click', () => setMobileOpen(false));
    });

    document.addEventListener(
      'click',
      (e) => {
        if (!isMobileOpen()) return;
        const target = e.target as Node | null;
        if (target && (mobileMenu?.contains(target) || menuToggle?.contains(target))) return;
        setMobileOpen(false);
      },
      { signal }
    );

    window.addEventListener(
      'scroll',
      () => {
        if (isMobileOpen() && Math.abs(window.scrollY - openScrollY) > 10) {
          setMobileOpen(false);
        }
      },
      { signal, passive: true }
    );

    document.addEventListener(
      'keydown',
      (e) => {
        if (e.key === 'Escape' && isMobileOpen()) setMobileOpen(false);
      },
      { signal }
    );
  }

  document.addEventListener('astro:page-load', bindHeader);
  bindHeader();
</script>
