---
/**
 * 服务端内联 SVG 图标（短名查字典，零客户端 JS）
 */
import { getIconPath, type IconName } from './icon-paths';

interface Props {
  name: IconName;
  class?: string;
  id?: string;
}

const { name, class: className = '', id } = Astro.props;
const body = getIconPath(name);
---

{body && (
  <svg
    xmlns="http://www.w3.org/2000/svg"
    id={id}
    class={className}
    width="1em"
    height="1em"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    set:html={body}
  />
)}
