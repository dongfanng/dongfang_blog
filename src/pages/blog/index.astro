---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleCard from '@/components/article/ArticleCard.astro';
import { getPublishedPosts, sortPosts, getCategories } from '@/utils/posts';

const posts = await getPublishedPosts();
const sortedPosts = sortPosts(posts);
const categories = getCategories(posts);
---

<BaseLayout title="文章">
  <div class="container-prose py-12">
    <header class="mb-8">
      <h1 class="text-3xl font-bold text-gray-900 dark:text-white mb-2">文章</h1>
      <p class="text-gray-600 dark:text-gray-400">共 {sortedPosts.length} 篇文章</p>
    </header>

    <div class="mb-8 flex flex-wrap items-center justify-between gap-4">
      <nav aria-label="文章分类" class="flex flex-wrap gap-2">
        <a href="/blog" aria-current="page" class="px-3 py-1.5 rounded-full text-sm font-medium bg-primary-50 text-primary-700 dark:bg-primary-950/50 dark:text-primary-300">
          全部
        </a>
        {categories.map((category) => (
          <a
            href={`/blog/categories/${category}`}
            class="px-3 py-1.5 rounded-full text-sm bg-gray-100 text-gray-700 dark:bg-gray-800 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors"
          >
            {category}
          </a>
        ))}
      </nav>
      <a href="/blog/tags" class="text-sm text-primary-500 dark:text-primary-400 hover:underline shrink-0">
        浏览全部标签 →
      </a>
    </div>

    <!-- 文章列表 -->
    <div class="grid gap-6">
      {sortedPosts.map((post) => (
        <ArticleCard post={post} />
      ))}
    </div>
  </div>
</BaseLayout>
