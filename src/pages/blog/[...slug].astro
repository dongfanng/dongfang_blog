---
import PostLayout from '@/layouts/PostLayout.astro';
import { getPublishedPosts, getRelatedPosts, getSeriesNav } from '@/utils/posts';
import { getGitLastModified } from '@/utils/last-modified';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const posts = await getPublishedPosts();
const related = getRelatedPosts(post, posts);
const seriesNav = getSeriesNav(post, posts);
const { Content, headings } = await post.render();

// 手动 updatedDate 优先，否则用 git 最后提交时间
const updatedDate = post.data.updatedDate ?? getGitLastModified(post.id);
---

<PostLayout {post} {related} {seriesNav} {headings} {updatedDate}>
  <Content />
</PostLayout>
