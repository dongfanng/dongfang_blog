---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleCard from '@/components/article/ArticleCard.astro';
import CategoryBar from '@/components/article/CategoryBar.astro';
import Pagination from '@/components/article/Pagination.astro';
import HeroBanner from '@/components/banner/HeroBanner.astro';
import { getPublishedPosts, sortPosts, getCategories, paginatePosts } from '@/utils/posts';
import { siteConfig } from '@/config/site';

const posts = await getPublishedPosts();
const { posts: pagePosts, totalPages } = paginatePosts(sortPosts(posts), 1, siteConfig.home.postsPerPage);
---
<BaseLayout title={siteConfig.name} description={siteConfig.description}>
  <HeroBanner />
  <div class="container-prose py-12">
    <CategoryBar categories={getCategories(posts)} />
    <div class="grid gap-6">
      {pagePosts.map((post, index) => <ArticleCard post={post} priority={index === 0} />)}
    </div>
    <Pagination currentPage={1} {totalPages} />
  </div>
</BaseLayout>
