---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleCard from '@/components/article/ArticleCard.astro';
import HeroBanner from '@/components/banner/HeroBanner.astro';
import { getPublishedPosts, sortPosts, getCategories, getTags, getSeriesList, getSeriesHref } from '@/utils/posts';
import { siteConfig } from '@/config/site';

const posts = await getPublishedPosts();
const sortedPosts = sortPosts(posts);
const recentPosts = sortedPosts.slice(0, siteConfig.home.recentPostsCount);
const categories = getCategories(posts);
const tags = getTags(posts);
const seriesList = getSeriesList(posts);
---

<BaseLayout title={siteConfig.name} description={siteConfig.description}>
  <!-- 横幅壁纸 Hero -->
  <HeroBanner />

  <div class="container-prose py-12">

    <!-- 最新文章 -->
    <section class="mb-12">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white">最新文章</h2>
        <a href="/blog" class="text-primary-500 dark:text-primary-400 hover:underline">
          查看全部 →
        </a>
      </div>
      <div class="grid gap-6">
        {recentPosts.map((post, index) => (
          <ArticleCard post={post} priority={index === 0} />
        ))}
      </div>
    </section>

    <!-- 分类 / 标签 / 系列 -->
    <section class:list={['grid gap-8', seriesList.length > 0 ? 'md:grid-cols-3' : 'md:grid-cols-2']}>
      <div>
        <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4">分类</h2>
        <div class="flex flex-wrap gap-2">
          {categories.map((category) => (
            <a
              href={`/blog/categories/${category}`}
              class="inline-flex items-center px-3 py-1.5 rounded-full text-sm font-medium bg-gray-100 text-gray-700 dark:bg-gray-800 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors"
            >
              {category}
            </a>
          ))}
        </div>
      </div>
      <div>
        <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4">标签</h2>
        <div class="flex flex-wrap gap-2">
          {tags.map((tag) => (
            <a
              href={`/blog/tags/${tag}`}
              class="inline-flex items-center px-3 py-1.5 rounded-full text-sm font-medium bg-gray-100 text-gray-700 dark:bg-gray-800 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors"
            >
              #{tag}
            </a>
          ))}
        </div>
      </div>
      {seriesList.length > 0 && (
        <div>
          <div class="flex items-center justify-between mb-4 gap-2">
            <h2 class="text-xl font-bold text-gray-900 dark:text-white">系列</h2>
            <a href="/blog/series" class="text-sm text-primary-500 dark:text-primary-400 hover:underline shrink-0">
              全部系列 →
            </a>
          </div>
          <div class="flex flex-wrap gap-2">
            {seriesList.map(({ name, count }) => (
              <a
                href={getSeriesHref(name)}
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-sm font-medium bg-primary-50 text-primary-700 dark:bg-primary-950/50 dark:text-primary-300 hover:bg-primary-100 dark:hover:bg-primary-900/50 transition-colors"
              >
                {name}
                <span class="text-xs opacity-70">{count}</span>
              </a>
            ))}
          </div>
        </div>
      )}
    </section>
  </div>
</BaseLayout>
